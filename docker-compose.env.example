# ============================================================
# MyBank — Переменные окружения для Docker Compose
# ============================================================
# Скопируйте в docker-compose.env и заполните значения:
#   cp docker-compose.env.example docker-compose.env

# NGROK (для внешнего доступа, опционально)
NGROK_AUTHTOKEN=your-ngrok-authtoken
NGROK_PUBLIC_DOMAIN=your-domain.ngrok-free.dev

# Keycloak Client Secrets
# Keycloak Client Secrets
KC_CLIENT_SECRET_ACCOUNTS_SERVICE=your-accounts-client-secret
KC_CLIENT_SECRET_CASH_SERVICE=your-cash-client-secret
KC_CLIENT_SECRET_TRANSFER_SERVICE=your-transfer-client-secret
KC_CLIENT_SECRET_NOTIFICATIONS_SERVICE=your-notifications-client-secret