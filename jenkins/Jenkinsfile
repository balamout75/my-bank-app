pipeline {
    agent any
    environment {
        DOCKER_REGISTRY = credentials('DOCKER_REGISTRY')
        DB_PASSWORD     = credentials('DB_PASSWORD')
        GITHUB_USERNAME = credentials('GITHUB_USERNAME')
        DB_NAME         = 'mybank'
        DB_USER         = 'mybank'
        IMAGE_TAG       = "${env.BUILD_NUMBER}"
        CHART_DIR       = 'k8s'
        KC_SECRET_ACCOUNTS      = credentials('KC_SECRET_ACCOUNTS')
        KC_SECRET_CASH          = credentials('KC_SECRET_CASH')
        KC_SECRET_TRANSFER      = credentials('KC_SECRET_TRANSFER')
        KC_SECRET_NOTIFICATIONS = credentials('KC_SECRET_NOTIFICATIONS')
    }
    stages {
        stage('Build & Test') {
            steps {
                sh 'mvn clean install'
            }
        }

        stage('Build Docker Images') {
            steps {
                sh """
                docker build -f Dockerfile.build --build-arg MODULE=accounts-service -t ${DOCKER_REGISTRY}/mybank-accounts:${IMAGE_TAG} .
                docker build -f Dockerfile.build --build-arg MODULE=cash-service -t ${DOCKER_REGISTRY}/mybank-cash:${IMAGE_TAG} .
                docker build -f Dockerfile.build --build-arg MODULE=transfer-service -t ${DOCKER_REGISTRY}/mybank-transfer:${IMAGE_TAG} .
                docker build -f Dockerfile.build --build-arg MODULE=notifications-service -t ${DOCKER_REGISTRY}/mybank-notifications:${IMAGE_TAG} .
                docker build -f Dockerfile.build --build-arg MODULE=gateway-service -t ${DOCKER_REGISTRY}/mybank-gateway:${IMAGE_TAG} .
                docker build -f Dockerfile.build --build-arg MODULE=front-ui -t ${DOCKER_REGISTRY}/mybank-frontend:${IMAGE_TAG} .
                """
            }
        }

        stage('Push Docker Images') {
            steps {
                withCredentials([string(credentialsId: 'GHCR_TOKEN', variable: 'GHCR_TOKEN')]) {
                    sh """
                    echo \$GHCR_TOKEN | docker login ghcr.io -u ${GITHUB_USERNAME} --password-stdin
                    docker push ${DOCKER_REGISTRY}/mybank-accounts:${IMAGE_TAG}
                    docker push ${DOCKER_REGISTRY}/mybank-cash:${IMAGE_TAG}
                    docker push ${DOCKER_REGISTRY}/mybank-transfer:${IMAGE_TAG}
                    docker push ${DOCKER_REGISTRY}/mybank-notifications:${IMAGE_TAG}
                    docker push ${DOCKER_REGISTRY}/mybank-gateway:${IMAGE_TAG}
                    docker push ${DOCKER_REGISTRY}/mybank-frontend:${IMAGE_TAG}
                    """
                }
            }
        }

        stage('Helm Deploy to TEST') {
            steps {
                sh """
                helm dependency update ${CHART_DIR}
                helm upgrade --install mybank-test ${CHART_DIR} \
                  --namespace test --create-namespace \
                  --set global.appHost=mybank.test.local \
                  --set global.keycloakHost=keycloak.test.local \
                  --set global.postgresql.password=${DB_PASSWORD} \
                  --set accounts-service.image.repository=${DOCKER_REGISTRY}/mybank-accounts \
                  --set accounts-service.image.tag=${IMAGE_TAG} \
                  --set cash-service.image.repository=${DOCKER_REGISTRY}/mybank-cash \
                  --set cash-service.image.tag=${IMAGE_TAG} \
                  --set transfer-service.image.repository=${DOCKER_REGISTRY}/mybank-transfer \
                  --set transfer-service.image.tag=${IMAGE_TAG} \
                  --set notifications-service.image.repository=${DOCKER_REGISTRY}/mybank-notifications \
                  --set notifications-service.image.tag=${IMAGE_TAG} \
                  --set gateway-service.image.repository=${DOCKER_REGISTRY}/mybank-gateway \
                  --set gateway-service.image.tag=${IMAGE_TAG} \
                  --set front-ui.image.repository=${DOCKER_REGISTRY}/mybank-frontend \
                  --set front-ui.image.tag=${IMAGE_TAG} \
                  --set accounts-service.keycloak.clientSecret=${KC_SECRET_ACCOUNTS} \
                  --set cash-service.keycloak.clientSecret=${KC_SECRET_CASH} \
                  --set transfer-service.keycloak.clientSecret=${KC_SECRET_TRANSFER} \
                  --set notifications-service.keycloak.clientSecret=${KC_SECRET_NOTIFICATIONS} \
                  --wait --timeout 5m
                """
            }
        }

        stage('Verify TEST') {
            steps {
                sh 'kubectl get pods -n test'
            }
        }

        stage('Manual Approval for PROD') {
            steps {
                input message: 'Deploy to PROD environment?', ok: 'Yes, deploy'
            }
        }

        stage('Helm Deploy to PROD') {
            steps {
                sh """
                helm dependency update ${CHART_DIR}
                helm upgrade --install mybank-prod ${CHART_DIR} \
                  --namespace prod --create-namespace \
                  --set global.appHost=mybank.prod.local \
                  --set global.keycloakHost=keycloak.prod.local \
                  --set global.postgresql.password=${DB_PASSWORD} \
                  --set accounts-service.image.repository=${DOCKER_REGISTRY}/mybank-accounts \
                  --set accounts-service.image.tag=${IMAGE_TAG} \
                  --set cash-service.image.repository=${DOCKER_REGISTRY}/mybank-cash \
                  --set cash-service.image.tag=${IMAGE_TAG} \
                  --set transfer-service.image.repository=${DOCKER_REGISTRY}/mybank-transfer \
                  --set transfer-service.image.tag=${IMAGE_TAG} \
                  --set notifications-service.image.repository=${DOCKER_REGISTRY}/mybank-notifications \
                  --set notifications-service.image.tag=${IMAGE_TAG} \
                  --set gateway-service.image.repository=${DOCKER_REGISTRY}/mybank-gateway \
                  --set gateway-service.image.tag=${IMAGE_TAG} \
                  --set front-ui.image.repository=${DOCKER_REGISTRY}/mybank-frontend \
                  --set front-ui.image.tag=${IMAGE_TAG} \
                  --set accounts-service.keycloak.clientSecret=${KC_SECRET_ACCOUNTS} \
                  --set cash-service.keycloak.clientSecret=${KC_SECRET_CASH} \
                  --set transfer-service.keycloak.clientSecret=${KC_SECRET_TRANSFER} \
                  --set notifications-service.keycloak.clientSecret=${KC_SECRET_NOTIFICATIONS} \
                  --wait --timeout 5m
                """
            }
        }

        stage('Verify PROD') {
            steps {
                sh 'kubectl get pods -n prod'
            }
        }
    }

    post {
        always {
            sh 'docker logout ghcr.io || true'
        }
        success {
            echo '✅ MyBank deployed successfully!'
        }
        failure {
            echo '❌ Deployment failed!'
        }
    }
}